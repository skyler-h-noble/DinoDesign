{
  // A consumer's view of the published types: strict, as a new Vite React-TS
  // app is (skipLibCheck too, as that template sets it). Run by `npm run
  // test:types` after build:types. If this fails, a TypeScript app fails.
  "compilerOptions": {
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "target": "ES2020",
    "module": "esnext",
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": { "@omni-design/components": ["../dist/types/components/index.d.ts"] },
    "typeRoots": ["../node_modules/@types"]
  },
  "files": ["consumer.tsx", "quickstart.tsx", "rejects.tsx"]
}
