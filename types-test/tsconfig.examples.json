{
  // The @example blocks from types/ (generated by scripts/check-api-examples.mjs),
  // compiled as a consumer would. Separate from tsconfig.json only to relax
  // noUnused*: the shared prelude declares state no single example uses all of.
  "extends": "./tsconfig.json",
  "compilerOptions": { "noUnusedLocals": false, "noUnusedParameters": false },
  "files": ["api-examples.tsx"]
}
